APP_NAME=Petalsinajar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# One database for everything, inventory included: PostgreSQL with PostGIS
# (Amazon RDS in production; run CREATE EXTENSION postgis there once, see README).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=event_app
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@petalsinajar.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Event App ---------------------------------------------------------------
APP_CURRENCY=GHS
BUSINESS_TIMEZONE=Africa/Accra
COMMISSION_PERCENT=10
SERVICE_FEE_PERCENT=3
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60
# Local/testing always accept this OTP and send no SMS.
OTP_DEV_CODE=123456
# log | cbmessaging
SMS_DRIVER=log
SMS_KEY=
SMS_SECRET=
SMS_SENDER_ID=

# fake (local) | paystack
PAYMENT_GATEWAY=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Push through OneSignal; without a key, notifications only reach the in-app list.
ONESIGNAL_REST_API_KEY=

RECOMMENDATIONS_ENABLED=true

# ---- Media: Cloudflare R2 (images) + Stream (video), see README "Deploying" -----
# r2 | fake (fake keeps files in memory; tests only)
MEDIA_STORAGE=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=petals-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public CDN domain in front of the private bucket
MEDIA_CDN_URL=https://media.petalsinajar.com
# imagick (reads HEIC) | gd
MEDIA_IMAGE_DRIVER=imagick

# cloudflare | fake
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
# API token with Stream: Edit (not the R2 token)
CLOUDFLARE_STREAM_TOKEN=
# The "secret" returned when registering the Stream webhook (README, Deploying 7)
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_DELIVERY_URL=https://customer-<code>.cloudflarestream.com
